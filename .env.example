# Base URL of the backend (no trailing /api/customer)
SC_API_URL=https://staging-seif.witheldokan.com

# Store api-key (from customer_api_tokens). Identifies which store (tenant) you are.
# Server-side only: never prefix with NEXT_PUBLIC_. Staging resolves the store without it.
SC_API_KEY=

# How long (seconds) store content may be reused before refetching
SC_REVALIDATE_SECONDS=60
