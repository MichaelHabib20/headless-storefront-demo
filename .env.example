# Base URL of the backend (no trailing /api/customer)
SC_API_URL=https://staging-seif.witheldokan.com

# Store api-key (from customer_api_tokens). Identifies which store (tenant) you are.
# Server-side only: never prefix with NEXT_PUBLIC_. Staging resolves the store without it.
SC_API_KEY=

# How long (seconds) store content may be reused before refetching
SC_REVALIDATE_SECONDS=60

# Public URL of this storefront (no trailing slash), e.g. https://shop.example.com
# Optional: online payments send the shopper back to <this>/<locale>/checkout/result. When empty,
# the origin of the shopper's request is used. Set it behind a proxy that hides the public host.
SC_SITE_URL=

# Preview only (set by the AI editor on its preview, never on the live site): the backend then shows
# unpublished section drafts and nothing is cached. Server-side only: never prefix with NEXT_PUBLIC_.
SC_PREVIEW_TOKEN=
